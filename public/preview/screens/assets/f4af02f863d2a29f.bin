.fake-brand{font-family:ui-serif,Georgia,Charter,"Bitstream Charter","DejaVu Serif",serif;font-size:20px;font-weight:500}
.fake-hero h1{font-family:ui-serif,Georgia,Charter,"Bitstream Charter","DejaVu Serif",serif;font-size:38px;font-weight:400;color:#3d3929}
fieldset.fake-shell{margin:0;min-width:0;padding:14px 12px 10px 16px;border-color:#dedcd1;box-shadow:0 4px 20px rgba(60,50,30,.05)}
.fake-cl-tools{margin-top:10px;align-items:center}
.fake-cl-tools .fake-icon-btn{width:32px;height:32px;border-radius:8px;border:1px solid var(--border)}
.fake-cl-tools .fake-model{font-size:14px;color:var(--muted)}
.fake-cl-composer .fake-send{border-radius:10px;width:32px;height:32px}
.fake-cl-composer .ProseMirror{font-size:16px;min-height:24px}
.fake-cl-user{display:flex;align-items:flex-start;gap:10px;max-width:85%;align-self:flex-start;background:var(--bubble);border-radius:14px;padding:10px 14px}
.fake-cl-user .fake-avatar{width:26px;height:26px;font-size:10px}
.fake-cl-user [data-testid=user-message]{white-space:pre-wrap;overflow-wrap:anywhere;padding-top:1px}
.font-claude-message{font-family:ui-serif,Georgia,Charter,"Bitstream Charter","DejaVu Serif",serif;font-size:16.5px;line-height:1.7}
